# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored, so your real key never goes to GitHub.

# Which AI provider to use: gemini (free tier), mimo (paid) or ollama (local, free)
AI_PROVIDER=gemini

# Your API key from the provider (Gemini: https://aistudio.google.com/apikey)
# Not needed for ollama.
AI_API_KEY=

# Optional overrides (leave commented to use the provider's defaults)
# AI_MODEL=gemini-3.5-flash-lite
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
