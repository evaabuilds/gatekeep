# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored, so your real key never goes to GitHub.

# Which AI provider to use: mimo, gemini or ollama
AI_PROVIDER=mimo

# Your API key from the provider's console (not needed for ollama)
AI_API_KEY=

# Optional overrides (leave empty to use the provider's defaults)
# AI_MODEL=mimo-v2.6-flash
# AI_BASE_URL=https://api.xiaomimimo.com/v1
